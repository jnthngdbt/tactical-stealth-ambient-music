# Copy this file to ".env.local" (already gitignored) and fill in ONE of the
# two options below to enable overwatch/'s photorealistic 3D tiles.

# Option A (recommended to start): free Cesium Ion access token.
# Sign up at https://ion.cesium.com, create an Access Token, and every
# account automatically has a "Google Photorealistic 3D Tiles" asset
# available (id 2275207) that overwatch/ uses by default.
VITE_ION_KEY=

# Option B: a Google Maps Platform API key with the "Map Tiles API" enabled
# and billing configured on the Google Cloud project. If set, this takes
# priority over VITE_ION_KEY. Restrict the key by HTTP referrer in the
# Google Cloud Console before deploying anywhere public.
VITE_GOOGLE_MAPS_API_KEY=
